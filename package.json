{
  "name": "audio-normalizer",
  "private": true,
  "version": "0.1.0",
  "description": "Normalizador de loudness para vídeos (Tauri + Rust + libav)",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "node tools/lint/node_modules/eslint/bin/eslint.js -c tools/lint/eslint.config.mjs src",
    "lint:fix": "node tools/lint/node_modules/eslint/bin/eslint.js -c tools/lint/eslint.config.mjs src --fix",
    "lint:install": "npm --prefix tools/lint ci",
    "test:ui": "node --test tests/*.test.mjs",
    "tauri": "tauri --config backend/tauri.conf.json",
    "app:dev": "tauri dev --config backend/tauri.conf.json",
    "app:build": "tauri build --config backend/tauri.conf.json",
    "test:core": "cargo test --manifest-path backend/Cargo.toml",
    "version:set": "node scripts/set-version.mjs"
  },
  "dependencies": {
    "@fluent/bundle": "^0.19.1",
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/plugin-dialog": "^2.8.0",
    "@tauri-apps/plugin-updater": "^2.13.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
